PORT=4000
# Neon connection string — copy from Neon dashboard > Connection Details (use the "pooled" one)
DATABASE_URL=postgresql://user:password@ep-xxxxxxxx.region.aws.neon.tech/instant_mechanic?sslmode=require

# Guards POST /api/admin/seed from being publicly callable — set to any random string
SEED_SECRET=change-me-to-a-random-secret

# Signs/verifies login tokens — set to any random string
JWT_SECRET=change-me-to-a-random-secret
